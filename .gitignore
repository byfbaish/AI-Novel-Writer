# 依赖
node_modules

# 构建输出
dist
dist-electron
release

# 日志
logs
*.log
npm-debug.log*
pnpm-debug.log*

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 系统文件
.DS_Store
Thumbs.db

# 环境变量
.env
.env.local
.env.*.local

# 临时文件
*.local
dist-ssr
tailwind.config.js.bak

# 可再生的本地审查、包管理与门禁状态
.review-temp/
.pnpm-store/
.workbuddy/
.release-gate*.txt
/.vitest-attachments/

# 创作资产包是作者的本地备份（含提示词 / 写作 Skill / 皮肤），永不入库。
# 它们由设置页「备份与迁移」导出到作者自选位置，属于个人资产而非项目源码。
*.vela-pack

# 本地工具索引与会话
.codegraph/
.superpowers/
.worktrees/
.runtime/
.backups/
.vibe-owner.json

# Never publish internal agent instructions, local review output, or compiler state.
/CONTEXT.md
/.agents/
/.claude/
/.codex/
/.superpowers/
/docs/superpowers/
/design-qa.md
/rule.md
/rule.lite.md
/output/
/public/screenshot/
/public/logos/
*.tsbuildinfo

# 浏览器测试（vitest browser mode）产出的视觉基线截图，非源码，不入库。
**/__screenshots__/

# pnpm is the package manager of record (see packageManager in package.json).
# A stray npm package-lock.json is never authoritative here.
/package-lock.json
.tmp-*

# 任务看板是各 worktree 的本地运行状态（卡、租约、报告），不随仓库分发。
.dsh-task-board/

# 临时脚本 / 样本 / 取证产物：按约定刻意不入库（见 docs/handoffs、docs/agents）。
/scripts/.tmp/

# 夜班运行账本：机器信号、桥接投递、草稿、临时取证、归档一律不入库；
# 但“协作介质”入库——卡面、裁定、会签、台账清单、名册、评审请求是团队唯一的权威源，
# 不是运行时残留。版本由 git 承担（分支／提交），文件名不再带 vN（2026-11-17 定）。
# 脚本一律走 /scripts/，不放 .batch/night/tools。
/.batch/*
!/.batch/night/
/.batch/night/*
!/.batch/night/cards/
!/.batch/night/org/
!/.batch/night/reports/
!/.batch/night/review-requests/
!/.batch/night/roster/
!/.batch/night/staging/
!/.batch/night/archive/
# 会话日志不入库（CARD-1119-H）：含 system prompt 与群内容全文，原件留本机 quarantine。
/.batch/night/staging/tmp-c9ff5961.jsonl

# 唤醒脚本目录入库，但投递残留文件不入库。
/scripts/dsh/wakeup-inbox/**
